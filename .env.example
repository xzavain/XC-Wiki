# XC Wiki environment template — copy to .env and fill in.
#   cp .env.example .env
#
# In Coolify, paste these into the service's Environment Variables instead.

# REQUIRED for Cloud Backup (Drive/OneDrive token encryption).
# Generate with:  openssl rand -hex 32
# Set it once and never change it — changing it invalidates stored credentials.
ENCRYPTION_KEY=

# Port the app listens on inside the container (default 3000).
# OPTIONAL — only change if you map a different host port in docker-compose.yml.
PORT=3000
